module "wrapper" {
  source = "../"

  for_each = var.items

  name                               = try(each.value.name, var.defaults.name, each.key)
  repository                         = try(each.value.repository, var.defaults.repository, "https://github.com/clouddrove/terraform-aws-kms")
  environment                        = try(each.value.environment, var.defaults.environment, "")
  label_order                        = try(each.value.label_order, var.defaults.label_order, ["name", "environment"])
  attributes                         = try(each.value.attributes, var.defaults.attributes, [])
  managedby                          = try(each.value.managedby, var.defaults.managedby, "hello@clouddrove.com")
  tags                               = try(each.value.tags, var.defaults.tags, {})
  region                             = try(each.value.region, var.defaults.region, null)
  deletion_window_in_days            = try(each.value.deletion_window_in_days, var.defaults.deletion_window_in_days, 10)
  description                        = try(each.value.description, var.defaults.description, "Parameter Store KMS master key")
  enabled                            = try(each.value.enabled, var.defaults.enabled, true)
  kms_key_enabled                    = try(each.value.kms_key_enabled, var.defaults.kms_key_enabled, true)
  key_usage                          = try(each.value.key_usage, var.defaults.key_usage, "ENCRYPT_DECRYPT")
  alias                              = try(each.value.alias, var.defaults.alias, "")
  create_alias                       = try(each.value.create_alias, var.defaults.create_alias, true)
  aliases                            = try(each.value.aliases, var.defaults.aliases, [])
  customer_master_key_spec           = try(each.value.customer_master_key_spec, var.defaults.customer_master_key_spec, "SYMMETRIC_DEFAULT")
  enable_key_rotation                = try(each.value.enable_key_rotation, var.defaults.enable_key_rotation, true)
  rotation_period_in_days            = try(each.value.rotation_period_in_days, var.defaults.rotation_period_in_days, null)
  custom_key_store_id                = try(each.value.custom_key_store_id, var.defaults.custom_key_store_id, null)
  xks_key_id                         = try(each.value.xks_key_id, var.defaults.xks_key_id, null)
  multi_region                       = try(each.value.multi_region, var.defaults.multi_region, true)
  bypass_policy_lockout_safety_check = try(each.value.bypass_policy_lockout_safety_check, var.defaults.bypass_policy_lockout_safety_check, false)
  valid_to                           = try(each.value.valid_to, var.defaults.valid_to, null)
  key_material_base64                = try(each.value.key_material_base64, var.defaults.key_material_base64, null)
  create_external_enabled            = try(each.value.create_external_enabled, var.defaults.create_external_enabled, false)
  primary_external_key_arn           = try(each.value.primary_external_key_arn, var.defaults.primary_external_key_arn, null)
  primary_key_arn                    = try(each.value.primary_key_arn, var.defaults.primary_key_arn, "")
  policy                             = try(each.value.policy, var.defaults.policy, null)
  create_replica_enabled             = try(each.value.create_replica_enabled, var.defaults.create_replica_enabled, false)
  create_replica_external_enabled    = try(each.value.create_replica_external_enabled, var.defaults.create_replica_external_enabled, false)
  grants                             = try(each.value.grants, var.defaults.grants, {})
}
